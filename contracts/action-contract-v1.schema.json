{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuanli.life/schemas/action-contract-v1.schema.json",
  "title": "Yuanli Health Action Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "principal_ref",
    "objective",
    "action_class",
    "allowed_domains",
    "allowed_actions",
    "requires_approval",
    "issued_at",
    "expires_at",
    "receipt_required",
    "idempotency_key",
    "schema_version"
  ],
  "properties": {
    "contract_id": {"type": "string", "pattern": "^ACT-[A-Za-z0-9._:-]+$"},
    "principal_ref": {"type": "string", "minLength": 3},
    "objective": {"type": "string", "minLength": 3, "maxLength": 200},
    "action_class": {
      "type": "string",
      "enum": ["READ", "PREPARE", "COMMIT", "CLINICAL", "DESTRUCTIVE"]
    },
    "allowed_domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 3}
    },
    "allowed_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 2}
    },
    "forbidden_actions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 2},
      "default": []
    },
    "payload": {
      "type": "object",
      "description": "Minimized action payload. Must never contain credentials or raw canonical health records.",
      "additionalProperties": true
    },
    "sensitivity": {
      "type": "string",
      "enum": ["public", "internal", "sensitive"],
      "default": "sensitive"
    },
    "requires_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principal", "clinician", "steward"],
      "properties": {
        "principal": {"type": "boolean"},
        "clinician": {"type": "boolean"},
        "steward": {"type": "boolean"}
      }
    },
    "approval_receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["actor_role", "approved_at", "receipt_ref"],
        "properties": {
          "actor_role": {"enum": ["principal", "clinician", "steward"]},
          "approved_at": {"type": "string", "format": "date-time"},
          "receipt_ref": {"type": "string", "minLength": 3}
        }
      },
      "default": []
    },
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "revoked": {"type": "boolean", "default": false},
    "receipt_required": {"const": true},
    "idempotency_key": {"type": "string", "minLength": 8},
    "policy_ref": {"type": "string"},
    "schema_version": {"const": "action-contract-v1"}
  },
  "allOf": [
    {
      "if": {"properties": {"action_class": {"const": "CLINICAL"}}},
      "then": {
        "properties": {
          "requires_approval": {
            "properties": {"clinician": {"const": true}}
          }
        }
      }
    },
    {
      "if": {"properties": {"action_class": {"enum": ["COMMIT", "DESTRUCTIVE"]}}},
      "then": {
        "properties": {
          "requires_approval": {
            "properties": {"principal": {"const": true}}
          }
        }
      }
    }
  ]
}
